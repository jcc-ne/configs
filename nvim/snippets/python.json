  "wait_loops": {
    "body": [
      "async def wait_for_tasks_loops(tasks, minutes=30, context=\"\"):",
      "    done = []",
      "    pending = []",
      "    for _ in tqdm.tqdm(range(minutes)):",
      "        done, pending = await asyncio.wait(tasks, timeout=60)",
      "        logger.info(f\"{context} Done: {len(list(done))}\")",
      "        logger.info(f\"{context} Pending: {len(list(pending))}\")",
      "        if not pending:",
      "            break",
      "    if len(pending) > 0:",
      "        logger.warning(f\"{context} still {len(pending)} tasks pending\")",
      "    return done, pending",
      "",
      ""
    ],
    "prefix": "wait_loops"
  },
