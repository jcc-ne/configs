  "async_tasks": {
    "body": [
      "",
      "@sync_to_async(thread_sensitive=False)",
      "def store_push_online(df_, push_source=\"{{cookiecutter.feature_name}}_push\", store=None):",
      "    if store is None:",
      "        store = get_store()",
      "    store.push(",
      "        push_source,",
      "        df_,",
      "        to=PushMode.ONLINE,",
      "    )",
      "",
      "# -- in main code",
      "    store = get_store()",
      "    event_df, _ = extract_agg_features_daily()",
      "    event_df = convert_date_type(event_df)",
      "    tasks = {}",
      "",
      "    logger.info(\"Pushing new entries to online store...\")",
      "    for i in tqdm(range(0, event_df.shape[0], BATCH_SIZE)):",
      "        coro = store_push_online",
      "        args = [event_df.iloc[i : i + BATCH_SIZE], \"plan_txn_rolling_agg_push\"]",
      "        kwargs = {\"store\": None}",
      "        # -- store task itself as key and args as value to allow re-create task",
      "        tasks[asyncio.create_task(coro(*args, **kwargs))] = (coro, args, kwargs)",
      "",
      "    logger.info(\"Checking progress of pushing tasks...\")",
      "    for _ in tqdm(range(60)):",
      "        done, pending = await asyncio.wait(list(tasks.keys()), timeout=60)",
      "        has_exception_in_done = False",
      "        for task in done:",
      "            if task.exception():",
      "                has_exception_in_done = True",
      "                logger.warning(f\"{task=} encountered exception {args=} {kwargs=}\")",
      "                coro, args, kwargs = tasks.pop(task)",
      "                tasks[asyncio.create_task(coro(*args, **kwargs))] = (coro, args, kwargs)",
      "",
      "        logger.info(f\"done: {len(done)}  pending: {len(pending)}\")",
      "        if not pending and not has_exception_in_done:",
      "            break",
      ""
    ],
    "prefix": "async_tasks"
  },
