  "img_convert": {
    "body": [
      "img =  (img - img.min()) / (img.max() - img.min())",
      "",
      "array = np.uint8(cm.seismic(img)*255)",
      "st.image(array)",
      "",
      "# color  = matplotlib.cm.seismic(img)",
      "im = Image.fromarray(array)",
      "st.image(im)",
      "# img = img * 0.001 - 273.15",
